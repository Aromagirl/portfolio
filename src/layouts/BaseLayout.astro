---
import '../styles/global.css';
import { withBase } from '../utils/paths';
import SiteHeader from '../components/theme/SiteHeader.astro';
import SiteFooter from '../components/theme/SiteFooter.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import PrototypeAnimations from '../components/PrototypeAnimations.astro';
import { prepareContentImages } from '../utils/image-previews.mjs';
interface Props { title: string; description?: string; home?: boolean; noindex?: boolean }
const previewImage = new URL(withBase('/images/brand/site-preview.png'), Astro.site).href;
const { title, description = 'Product and UX/UI design portfolio by Natalia Isakova, featuring digital platforms, responsive websites and mobile interfaces.', home = false, noindex = false } = Astro.props;
const pageTitle = home ? 'Natalia Isakova — Product & UX/UI Designer' : `${title} — Natalia Isakova`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const content = await prepareContentImages(await Astro.slots.render('default'), import.meta.env.BASE_URL);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-PJ927TXR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <script is:inline>
      (() => {
        // Keep one delegated listener even if this script runs again.
        if (window.portfolioContactTrackingInitialized) return;
        window.portfolioContactTrackingInitialized = true;

        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          const link = event.target.closest('a[href]');
          if (!link || !/^mailto:/i.test(link.getAttribute('href').trim())) return;
          if (typeof window.gtag !== 'function') return;

          // Do not send the link URL or text: both can contain an email address.
          window.gtag('event', 'contact_click');
        });
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F3F1E9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151817" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Natalia Isakova" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="Natalia Isakova — Product Designer & Builder" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content="Natalia Isakova — Product Designer & Builder" />
    <link rel="icon" href={withBase('/favicon.svg?v=ni-3')} type="image/svg+xml" />
    <link rel="preload" href={withBase('/fonts/hanken-grotesk/hanken-grotesk-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        const storageKey = 'portfolio-theme';
        const root = document.documentElement;
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        let stored = null;
        try { const value = localStorage.getItem(storageKey); if (value === 'dark' || value === 'light') stored = value; } catch {}
        const apply = (isDark) => {
          root.classList.toggle('dark', isDark);
          document.querySelectorAll('[data-theme-toggle]').forEach(button => button.setAttribute('aria-pressed', String(isDark)));
        };
        apply(stored ? stored === 'dark' : systemDark.matches);
        systemDark.addEventListener('change', event => { if (!stored) apply(event.matches); });
        document.addEventListener('DOMContentLoaded', () => {
          apply(root.classList.contains('dark'));
          document.querySelectorAll('[data-theme-toggle]').forEach(button => button.addEventListener('click', () => {
            const isDark = !root.classList.contains('dark');
            stored = isDark ? 'dark' : 'light';
            try { localStorage.setItem(storageKey, stored); } catch {}
            apply(isDark);
          }));
        });
      })();
    </script>
    <noscript><style>[data-needs-js]{display:none!important}</style></noscript>
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class:list={['flex-1', { 'home-page': home }]}><Fragment set:html={content} /></main>
    <SiteFooter />
    <ScrollReveal />
    <PrototypeAnimations />
  </body>
</html>
