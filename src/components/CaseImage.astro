---
import manifest from '../../migration/manifest.json';
import { withBase } from '../utils/paths';
const { src, alt = '', disabled = false } = Astro.props;
const ImageLink = disabled ? 'span' : 'a';
const asset = manifest.pages.flatMap(p => p.assets).find(a => 'localPath' in a && a.localPath === src);
const animated = asset && 'animated' in asset && asset.animated;
const poster = animated && 'poster' in asset ? asset.poster : src;
const eager = src === '/images/projects/home/01.webp';
---
<span class="case-media">
  {animated && !disabled && <button class="animation-toggle" type="button" data-animation={withBase(src)} data-poster={withBase(poster)} aria-pressed="false">Play prototype animation</button>}
  <ImageLink class="image-link" href={disabled ? undefined : withBase(src)} aria-label={disabled ? undefined : `Open image: ${alt}`}><img src={withBase(poster)} alt={alt} width={asset && 'outputWidth' in asset ? asset.outputWidth : undefined} height={asset && 'outputHeight' in asset ? asset.outputHeight : undefined} loading={eager ? 'eager' : 'lazy'} decoding="async" /></ImageLink>
</span>
