---
interface Props {
  image: { src: string; preview: string; label: string; mobile?: boolean; cropToGlossary?: boolean };
  version: string;
  project: string;
  featured?: boolean;
}
const { image, version, project, featured = false } = Astro.props;
---
<figure class:list={['shot', { featured, mobile: image.mobile, 'crop-to-glossary': image.cropToGlossary }]}>

  <a class="shot-link" href={image.src} data-gallery-image data-title={`${version} — ${image.label}${image.mobile ? ' · Mobile' : ''}`} aria-label={`View full page: ${project}, ${version}, ${image.label}${image.mobile ? ', mobile' : ''}`}>
    <img src={image.src} alt={`${project} — ${version}: ${image.label}${image.mobile ? ', mobile' : ''}`} loading="lazy" decoding="async" />

  </a>
  <figcaption><span>{image.label}</span><span class="device">{image.mobile ? 'Mobile' : 'Desktop'}</span></figcaption>
</figure>
<style>
  .shot{margin:0;min-width:0;background:none;border:0;border-radius:0;box-shadow:none;overflow:visible;outline:0}
  .shot.mobile{width:100%}
  @media(max-width:600px){.shot.mobile{width:50%}}
  figcaption{margin-top:.75rem;font-size:.85rem;line-height:1.5;color:var(--muted);text-align:left}
  .device::before{content:' · '}
  .shot-link{display:block;width:100%;max-height:36rem;cursor:zoom-in;border:1px solid var(--line);border-radius:var(--radius-panel);overflow:hidden;background:var(--surface)}
  img{display:block;width:100%;height:auto;object-fit:contain;object-position:top}
  .crop-to-glossary .shot-link{aspect-ratio:1920/5715}
  .crop-to-glossary img{height:100%;object-fit:cover;object-position:top}
  @media(min-width:601px){
    .featured{display:grid;grid-template-rows:subgrid;grid-row:span 2}
    .featured.mobile .shot-link{position:relative;min-height:0}
    .featured.mobile img{position:absolute;inset:0;height:100%;object-fit:cover;object-position:top}
  }
  .shot-link:focus-visible{outline:2px solid var(--ink);outline-offset:4px}
</style>
